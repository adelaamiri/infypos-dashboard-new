      <h2 id="customer-password-title">Customer Password</h2>
      <button class="modal-close" type="button" data-modal-close aria-label="Close">
        <i data-lucide="x"></i>
      </button>
    </header>
    <form class="modal-form compact-modal-form">
      <label>
        <span>Email:<b>*</b></span>
        <input type="email" value="Gmail@gmail.com">
      </label>
      <label>
        <span>Password:<b>*</b></span>
        <input type="password" placeholder="Enter Password">
      </label>
      <label>
        <span>Confirm Password:<b>*</b></span>
        <input type="password" placeholder="Enter Confirm Password">
      </label>
      <div class="modal-actions customer-password-actions">
        <button class="button-primary" type="submit">Save</button>
        <button class="button-muted" type="button" data-modal-close>Cancel</button>
      </div>
    </form>
  </section>

  <section class="app-modal transaction-modal" data-modal="transaction-modal" role="dialog" aria-modal="true" aria-labelledby="transaction-modal-title">
