  <section class="app-modal edit-record-modal" data-modal="edit-record-modal" role="dialog" aria-modal="true" aria-labelledby="edit-record-title">
    <header class="modal-header compact-modal-header">
      <h2 id="edit-record-title">Edit Details</h2>
      <button class="modal-close" type="button" data-modal-close aria-label="Close">
        <i data-lucide="x"></i>
