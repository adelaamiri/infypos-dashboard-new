      <div class="transaction-column">
        <h3>Customer Details</h3>
        <p><strong>Name:</strong> Mohit</p>
        <p><strong>Email:</strong> mohitinfyom@gmail.com</p>
        <p><strong>Phone:</strong> 9876543210</p>
        <p><strong>City:</strong> Surat</p>
      </div>
    </div>
    <div class="transaction-footer">
      <button class="button-muted" type="button" data-modal-close>Close</button>
