  </section>

  <section class="app-modal delete-modal" data-modal="delete-modal" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
    <div class="delete-modal-body">
      <div class="delete-icon" aria-hidden="true"><i data-lucide="trash-2"></i></div>
      <h2 id="delete-modal-title">Delete!</h2>
      <p>Are you sure want to delete this record ?</p>
      <div class="delete-modal-actions">
        <button class="delete-confirm" type="button" data-modal-close>Yes, Delete!</button>
        <button class="delete-cancel" type="button" data-modal-close>No, Cancel</button>
      </div>
    </div>
  </section>
</div>
