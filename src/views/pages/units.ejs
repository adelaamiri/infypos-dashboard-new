<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../layouts/head') %>
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>
    <main class="main-content product-main">
      <%- include('../partials/topbar') %>
      <section class="product-content">
        <div class="product-toolbar">
          <label class="product-search wide"><i data-lucide="search"></i><input type="search" placeholder="Search"></label>
          <div class="product-actions">
            <button class="filter-button" type="button" aria-label="Filter"><i data-lucide="filter"></i></button>
            <button class="create-button" type="button">Create Unit</button>
          </div>
        </div>
        <div class="product-table-card">
          <table class="product-table units-table">
            <thead>
              <tr>
                <th><input type="checkbox"></th>
                <th>Name</th>
                <th>Short Name</th>
                <th>Base Unit</th>
                <th>Created On</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% units.forEach(unit => { %>
                <tr>
                  <td><input type="checkbox"></td>
                  <td><%= unit.name %></td>
                  <td><span class="stock-pill stock-pill-blue"><%= unit.shortName %></span></td>
                  <td><span class="stock-pill stock-pill-green"><%= unit.baseUnit %></span></td>
                  <td><span class="date-pill"><%= unit.time %><br><%= unit.date %></span></td>
                  <td><%- include('../partials/table-actions', { copy: false, view: false }) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="pagination-row">
          <div>Records per page <button class="page-size" type="button">10 <i data-lucide="chevron-down"></i></button> <span>1-5 of 5</span></div>
          <div class="pager"><i data-lucide="chevrons-left"></i><i data-lucide="chevron-left"></i><i data-lucide="chevron-right"></i><i data-lucide="chevrons-right"></i></div>
        </div>
        <%- include('../partials/product-page-footer') %>
      </section>
    </main>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
