<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../layouts/head') %>
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>
    <main class="main-content product-main">
      <%- include('../partials/topbar') %>
      <section class="product-content">
        <div class="product-toolbar">
          <label class="product-search"><i data-lucide="search"></i><input type="search" placeholder="Search"></label>
          <div class="product-actions quotation-actions">
            <button class="filter-button" type="button" aria-label="Filter"><i data-lucide="filter"></i></button>
            <button class="date-filter" type="button">Select Date <i data-lucide="calendar-days"></i></button>
            <button class="create-button" type="button">Create Purchase Return</button>
          </div>
        </div>
        <div class="product-table-card">
          <table class="product-table operations-table returns-table">
            <thead>
              <tr>
                <th><input type="checkbox"></th>
                <th>Reference</th>
                <th>Supplier</th>
                <th>Warehouse</th>
                <th>Status</th>
                <th>Grand Total</th>
                <th>Created On</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% purchaseReturns.forEach(item => { %>
                <tr>
                  <td><input type="checkbox"></td>
                  <td><span class="code-pill"><%= item.reference %></span></td>
                  <td><%= item.supplier %></td>
                  <td><%= item.warehouse %></td>
                  <td><span class="status-pill <%= item.status === 'Pending' ? 'status-method' : item.status === 'Ordered' ? 'status-sent' : 'status-completed' %>"><%= item.status %></span></td>
                  <td><%= item.grandTotal %></td>
                  <td><span class="date-pill"><%= item.time %><br><%= item.date %></span></td>
                  <td><%- include('../partials/more-actions', {
                    menuKey: `purchase-return-${item.reference}`,
                    items: [
                      { label: 'View Purchase Return', icon: 'eye' },
                      { label: 'Download PDF', icon: 'file-down' },
                      { label: 'Edit Purchase Return', icon: 'square-pen' },
                      { label: 'Delete Purchase Return', icon: 'trash-2', modal: 'delete-modal' }
                    ]
                  }) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="pagination-row">
          <div>Records per page <button class="page-size" type="button">10 <i data-lucide="chevron-down"></i></button> <span>1-10 of 23</span></div>
          <div class="pager"><i data-lucide="chevrons-left"></i><i data-lucide="chevron-left"></i><i data-lucide="chevron-right"></i><i data-lucide="chevrons-right"></i></div>
        </div>
        <%- include('../partials/product-page-footer') %>
      </section>
    </main>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
