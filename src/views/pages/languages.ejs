<!DOCTYPE html>
<html lang="en">
<head><%- include('../layouts/head') %></head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>
    <main class="main-content product-main">
      <%- include('../partials/topbar') %>
      <section class="product-content">
        <div class="product-toolbar">
          <label class="product-search"><i data-lucide="search"></i><input type="search" placeholder="Search"></label>
          <button class="create-button" type="button">Create Language</button>
        </div>
        <div class="product-table-card">
          <table class="product-table operations-table settings-table languages-table">
            <thead>
              <tr><th>Name</th><th>ISO Code</th><th>Status</th><th>Translation</th><th>Action</th></tr>
            </thead>
            <tbody>
              <% languages.forEach(language => { %>
                <tr>
                  <td><%= language.name %></td>
                  <td><%= language.isoCode %></td>
                  <td><button class="status-switch <%= language.enabled ? 'is-on' : '' %>" type="button" data-toggle-switch aria-pressed="<%= language.enabled ? 'true' : 'false' %>" onclick="this.classList.toggle('is-on');this.setAttribute('aria-pressed', this.classList.contains('is-on'))"><span></span></button></td>
                  <td><a class="table-link" href="#">Edit Translation</a></td>
                  <td><%- include('../partials/table-actions', { copy: false, view: false }) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="pagination-row">
          <div>Records per page <button class="page-size" type="button">10 <i data-lucide="chevron-down"></i></button> <span>1-10 of 10</span></div>
          <div class="pager"><i data-lucide="chevrons-left"></i><i data-lucide="chevron-left"></i><i data-lucide="chevron-right"></i><i data-lucide="chevrons-right"></i></div>
        </div>
        <%- include('../partials/product-page-footer') %>
      </section>
    </main>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
