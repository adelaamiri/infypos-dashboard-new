<!DOCTYPE html>
<html lang="en">
<head><%- include('../layouts/head') %></head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>
    <main class="main-content product-main">
      <%- include('../partials/topbar') %>
      <section class="product-content">
        <div class="product-toolbar">
          <label class="product-search"><i data-lucide="search"></i><input type="search" placeholder="Search"></label>
          <button class="create-button" type="button">Create Role</button>
        </div>
        <div class="product-table-card">
          <table class="product-table operations-table roles-table">
            <thead><tr><th>Name</th><th>Date</th><th>Action</th></tr></thead>
            <tbody>
              <% roles.forEach(role => { %>
                <tr>
                  <td><%= role.name %></td>
                  <td><%= role.date %></td>
                  <td><% if (role.editable) { %><%- include('../partials/table-actions', { copy: false, view: false }) %><% } %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="pagination-row"><div>Records per page <button class="page-size" type="button">10 <i data-lucide="chevron-down"></i></button> <span>1-10 of 11</span></div><div class="pager"><i data-lucide="chevrons-left"></i><i data-lucide="chevron-left"></i><i data-lucide="chevron-right"></i><i data-lucide="chevrons-right"></i></div></div>
        <%- include('../partials/product-page-footer') %>
      </section>
    </main>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
