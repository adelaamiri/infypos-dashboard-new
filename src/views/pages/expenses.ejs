<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../layouts/head') %>
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>
    <main class="main-content product-main">
      <%- include('../partials/topbar') %>
      <section class="product-content">
        <div class="product-toolbar">
          <label class="product-search"><i data-lucide="search"></i><input type="search" placeholder="Search"></label>
          <button class="create-button" type="button">Create Expense</button>
        </div>
        <div class="product-table-card">
          <table class="product-table operations-table expenses-table">
            <thead>
              <tr>
                <th><input type="checkbox"></th>
                <th>Reference</th>
                <th>User</th>
                <th>Expense Title</th>
                <th>Warehouse</th>
                <th>Expense Category</th>
                <th>Amount</th>
                <th>Created On</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% expenses.forEach(expense => { %>
                <tr>
                  <td><input type="checkbox"></td>
                  <td><span class="code-pill"><%= expense.reference %></span></td>
                  <td><%= expense.user %></td>
                  <td><%= expense.title %></td>
                  <td><%= expense.warehouse %></td>
                  <td><%= expense.category %></td>
                  <td><%= expense.amount %></td>
                  <td><span class="date-pill"><%= expense.time %><br><%= expense.date %></span></td>
                  <td><%- include('../partials/table-actions', { copy: false, view: false }) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="pagination-row">
          <div>Records per page <button class="page-size" type="button">10 <i data-lucide="chevron-down"></i></button> <span>1-8 of 8</span></div>
          <div class="pager"><i data-lucide="chevrons-left"></i><i data-lucide="chevron-left"></i><i data-lucide="chevron-right"></i><i data-lucide="chevrons-right"></i></div>
        </div>
        <%- include('../partials/product-page-footer') %>
      </section>
    </main>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
