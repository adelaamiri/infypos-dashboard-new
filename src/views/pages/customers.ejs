<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../layouts/head') %>
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>
    <main class="main-content product-main">
      <%- include('../partials/topbar') %>
      <section class="product-content">
        <div class="product-toolbar">
          <label class="product-search"><i data-lucide="search"></i><input type="search" placeholder="Search"></label>
          <div class="product-actions people-actions">
            <button class="create-button" type="button">Import Customers</button>
            <button class="create-button" type="button">Create Customer</button>
          </div>
        </div>
        <div class="product-table-card">
          <table class="product-table operations-table people-table customers-table">
            <thead>
              <tr>
                <th><input type="checkbox"></th>
                <th>Customer</th>
                <th>Phone Number</th>
                <th>Created On</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% customers.forEach(customer => { %>
                <tr>
                  <td><input type="checkbox"></td>
                  <td>
                    <a class="person-name" href="#"><%= customer.name %></a>
                    <span class="person-email"><%= customer.email %></span>
                  </td>
                  <td><%= customer.phone %></td>
                  <td><span class="date-pill"><%= customer.time %><br><%= customer.date %></span></td>
                  <td>
                    <span class="table-actions">
                      <% if (customer.canAdd) { %><button class="add-user-action" type="button" aria-label="Add user" data-modal-open="customer-password-modal"><i data-lucide="user-plus"></i></button><% } %>
                      <button class="view-action" type="button" aria-label="View" data-modal-open="transaction-modal"><i data-lucide="eye"></i></button>
                      <button class="edit-action" type="button" aria-label="Edit" data-modal-open="edit-record-modal"><i data-lucide="square-pen"></i></button>
                      <button class="delete-action" type="button" aria-label="Delete" data-modal-open="delete-modal"><i data-lucide="trash-2"></i></button>
                    </span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="pagination-row">
          <div>Records per page <button class="page-size" type="button">10 <i data-lucide="chevron-down"></i></button> <span>1-10 of 16</span></div>
          <div class="pager"><i data-lucide="chevrons-left"></i><i data-lucide="chevron-left"></i><i data-lucide="chevron-right"></i><i data-lucide="chevrons-right"></i></div>
        </div>
        <%- include('../partials/product-page-footer') %>
      </section>
    </main>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
