<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../layouts/head') %>
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>
    <main class="main-content product-main">
      <%- include('../partials/topbar') %>
      <section class="product-content">
        <div class="product-toolbar">
          <label class="product-search"><i data-lucide="search"></i><input type="search" placeholder="Search"></label>
          <div class="product-actions">
            <button class="filter-button" type="button" aria-label="Filter"><i data-lucide="filter"></i></button>
            <button class="create-button" type="button">Create Product</button>
          </div>
        </div>

        <div class="product-table-card">
          <table class="product-table products-list-table">
            <thead>
              <tr>
                <th><input type="checkbox"></th>
                <th>Product</th>
                <th>Name</th>
                <th>Code</th>
                <th>Brand</th>
                <th>Price</th>
                <th>Product Unit</th>
                <th>In Stock</th>
                <th>Created On</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% products.forEach(product => { %>
                <tr>
                  <td><input type="checkbox"></td>
                  <td><span class="product-thumb <%= product.image %>">no image</span></td>
                  <td><%= product.name %></td>
                  <td><span class="code-pill"><%= product.code %></span></td>
                  <td><%= product.brand %></td>
                  <td><%= product.price %></td>
                  <td><span class="stock-pill stock-pill-green"><%= product.unit %></span></td>
                  <td><%= product.stock %></td>
                  <td><span class="date-pill"><%= product.time %><br><%= product.date %></span></td>
                  <td><%- include('../partials/table-actions', { copy: true }) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="pagination-row">
          <div>Records per page <button class="page-size" type="button">10 <i data-lucide="chevron-down"></i></button> <span>1-10 of 208</span></div>
          <div class="pager"><i data-lucide="chevrons-left"></i><i data-lucide="chevron-left"></i><i data-lucide="chevron-right"></i><i data-lucide="chevrons-right"></i></div>
        </div>
        <%- include('../partials/product-page-footer') %>
      </section>
    </main>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
