<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../layouts/head') %>
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>
    <main class="main-content product-main">
      <%- include('../partials/topbar') %>
      <section class="product-content">
        <div class="product-toolbar">
          <label class="product-search"><i data-lucide="search"></i><input type="search" placeholder="Search"></label>
          <div class="product-actions quotation-actions">
            <button class="filter-button" type="button" aria-label="Filter"><i data-lucide="filter"></i></button>
            <button class="date-filter" type="button">Select Date <i data-lucide="calendar-days"></i></button>
            <button class="create-button" type="button">Create Purchase</button>
          </div>
        </div>
        <div class="product-table-card">
          <table class="product-table operations-table purchases-table">
            <thead>
              <tr>
                <th><input type="checkbox"></th>
                <th>Reference</th>
                <th>Supplier</th>
                <th>Warehouse</th>
                <th>Status</th>
                <th>Grand Total</th>
                <th>Paid</th>
                <th>Due</th>
                <th>Payment Status</th>
                <th>Payment Type</th>
                <th>Created On</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% purchases.forEach(purchase => { %>
                <tr>
                  <td><input type="checkbox"></td>
                  <td><span class="code-pill"><%= purchase.reference %></span></td>
                  <td><%= purchase.supplier %></td>
                  <td><%= purchase.warehouse %></td>
                  <td><span class="status-pill status-completed"><%= purchase.status %></span></td>
                  <td><%= purchase.grandTotal %></td>
                  <td><%= purchase.paid %></td>
                  <td><%= purchase.due %></td>
                  <td><span class="status-pill <%= purchase.paymentStatus === 'Paid' ? 'status-completed' : 'status-pending' %>"><%= purchase.paymentStatus %></span></td>
                  <td><span class="status-pill <%= purchase.paymentType === '-' ? 'status-plain' : 'status-method' %>"><%= purchase.paymentType %></span></td>
                  <td><span class="date-pill"><%= purchase.time %><br><%= purchase.date %></span></td>
                  <td><%- include('../partials/more-actions', {
                    menuKey: `purchase-${purchase.reference}`,
                    items: [
                      { label: 'View Purchase', icon: 'eye' },
                      { label: 'Download PDF', icon: 'file-down' },
                      { label: 'Edit Purchase', icon: 'square-pen' },
                      { label: 'Delete Purchase', icon: 'trash-2', modal: 'delete-modal' }
                    ]
                  }) %></td>
                </tr>
              <% }) %>
              <tr class="table-total-row">
                <td></td>
                <td>Total</td>
                <td></td>
                <td></td>
                <td></td>
                <td>$ 5,399,2</td>
                <td>$ 224,8</td>
                <td>$ 5,174,5</td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="pagination-row">
          <div>Records per page <button class="page-size" type="button">10 <i data-lucide="chevron-down"></i></button> <span>1-10 of 338</span></div>
          <div class="pager"><i data-lucide="chevrons-left"></i><i data-lucide="chevron-left"></i><i data-lucide="chevron-right"></i><i data-lucide="chevrons-right"></i></div>
        </div>
        <%- include('../partials/product-page-footer') %>
      </section>
    </main>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
