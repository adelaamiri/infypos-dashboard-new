<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../layouts/head') %>
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>
    <main class="main-content product-main">
      <%- include('../partials/topbar') %>
      <section class="product-content">
        <div class="product-toolbar">
          <label class="product-search"><i data-lucide="search"></i><input type="search" placeholder="Search"></label>
          <div class="product-actions">
            <button class="filter-button" type="button" aria-label="Filter"><i data-lucide="filter"></i></button>
            <button class="create-button" type="button">Create Transfer</button>
          </div>
        </div>
        <div class="product-table-card">
          <table class="product-table operations-table transfers-table">
            <thead>
              <tr>
                <th><input type="checkbox"></th>
                <th>Reference</th>
                <th>From Warehouse</th>
                <th>To Warehouse</th>
                <th>Items</th>
                <th>Grand Total</th>
                <th>Status</th>
                <th>Created On</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% transfers.forEach(transfer => { %>
                <tr>
                  <td><input type="checkbox"></td>
                  <td><span class="code-pill"><%= transfer.reference %></span></td>
                  <td><%= transfer.fromWarehouse %></td>
                  <td><%= transfer.toWarehouse %></td>
                  <td><%= transfer.items %></td>
                  <td><%= transfer.grandTotal %></td>
                  <td><span class="status-pill <%= transfer.status === 'Sent' ? 'status-sent' : 'status-completed' %>"><%= transfer.status %></span></td>
                  <td><span class="date-pill"><%= transfer.time %><br><%= transfer.date %></span></td>
                  <td><%- include('../partials/table-actions', { copy: false }) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="pagination-row">
          <div>Records per page <button class="page-size" type="button">10 <i data-lucide="chevron-down"></i></button> <span>1-10 of 40</span></div>
          <div class="pager"><i data-lucide="chevrons-left"></i><i data-lucide="chevron-left"></i><i data-lucide="chevron-right"></i><i data-lucide="chevrons-right"></i></div>
        </div>
      </section>
    </main>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
