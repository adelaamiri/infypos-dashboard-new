<!DOCTYPE html>
<html lang="en">
<head><%- include('../layouts/head') %></head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>
    <main class="main-content product-main">
      <%- include('../partials/topbar') %>
      <section class="product-content">
        <div class="page-tabs"><a class="active" href="/wallet-requests">Wallet Requests</a><a href="#">Wallet Transactions</a></div>
        <div class="product-toolbar">
          <label class="product-search"><i data-lucide="search"></i><input type="search" placeholder="Search"></label>
          <button class="filter-button" type="button" aria-label="Filter"><i data-lucide="filter"></i></button>
        </div>
        <div class="product-table-card">
          <table class="product-table operations-table wallet-table">
            <thead>
              <tr><th>Customer Name</th><th>Transaction Type</th><th>Amount</th><th>Type</th><th>Created On</th><th>Action</th><th>View</th></tr>
            </thead>
            <tbody>
              <% walletRequests.forEach(item => { %>
                <tr>
                  <td><a class="person-name" href="#"><%= item.name %></a><span class="person-email"><%= item.email %></span></td>
                  <td><%= item.transactionType %></td>
                  <td><%= item.amount %></td>
                  <td><span class="status-pill status-method"><%= item.type %></span></td>
                  <td><span class="date-pill"><%= item.time %><br><%= item.date %></span></td>
                  <td><span class="status-pill <%= item.action === 'Approved' ? 'status-completed' : 'status-pending' %>"><%= item.action %></span></td>
                  <td><button class="view-action action-button" type="button" data-modal-open="transaction-modal"><i data-lucide="eye"></i></button></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="pagination-row"><div>Records per page <button class="page-size" type="button">10 <i data-lucide="chevron-down"></i></button> <span>1-4 of 4</span></div><div class="pager"><i data-lucide="chevrons-left"></i><i data-lucide="chevron-left"></i><i data-lucide="chevron-right"></i><i data-lucide="chevrons-right"></i></div></div>
        <%- include('../partials/product-page-footer') %>
      </section>
    </main>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
